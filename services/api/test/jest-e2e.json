{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@webinar/shared$": "<rootDir>/../../../packages/shared/src/index.ts"
  },
  "globalSetup": "<rootDir>/setup.ts"
}
